# ==== Webull 微牛 OpenAPI（沙盒 & 实盘） ====
# 真实值请填到本机 .env（已被 .gitignore 排除），不要提交到仓库
ENVIRONMENT=sandbox
SANDBOX_APP_KEY=your_sandbox_app_key
SANDBOX_APP_SECRET=your_sandbox_app_secret
PROD_APP_KEY=your_prod_app_key
PROD_APP_SECRET=your_prod_app_secret

